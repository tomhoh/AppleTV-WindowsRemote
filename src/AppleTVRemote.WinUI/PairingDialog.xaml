<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="AppleTVRemote.WinUI.PairingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Pair Apple TV"
    DefaultButton="Primary"
    PrimaryButtonText="Pair"
    SecondaryButtonText="Cancel"
    IsPrimaryButtonEnabled="False">

    <StackPanel Width="320" Spacing="10">
        <TextBlock x:Name="HeaderText"
                   Text="Discovering Apple TVs on your network…"
                   FontSize="14" FontWeight="SemiBold" />
        <TextBlock x:Name="SubText"
                   Text="Make sure your TV is awake and on the same network."
                   FontSize="11" Opacity="0.7" TextWrapping="Wrap" />

        <ListView x:Name="DeviceList"
                  Height="180"
                  BorderThickness="1"
                  BorderBrush="#33000000"
                  SelectionMode="Single"
                  SelectionChanged="OnDeviceSelected">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="4,2">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock FontSize="10" Opacity="0.6">
                            <Run Text="{Binding Address}" />
                            <Run Text=":" />
                            <Run Text="{Binding Port}" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <StackPanel x:Name="PinPanel" Visibility="Collapsed" Spacing="8">
            <TextBlock x:Name="PinPrompt"
                       Text="Enter the 4-digit PIN shown on your Apple TV:"
                       FontSize="12" />
            <PasswordBox x:Name="PinBox"
                         FontSize="20"
                         MaxLength="6"
                         HorizontalContentAlignment="Center" />
            <TextBlock x:Name="PinError"
                       Foreground="#CC0000"
                       Visibility="Collapsed"
                       FontSize="11" TextWrapping="Wrap" />
            <ProgressBar x:Name="PairProgress"
                         Height="3"
                         IsIndeterminate="True"
                         Visibility="Collapsed" />
        </StackPanel>
    </StackPanel>
</ContentDialog>
