<?xml version="1.0" encoding="utf-8"?>
<ContentDialog
    x:Class="AppleTVRemote.WinUI.PairingDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    DefaultButton="Primary"
    PrimaryButtonText="Pair"
    SecondaryButtonText="Cancel"
    IsPrimaryButtonEnabled="False">

    <!--
      Compact, mac-popover-shaped pairing view. Content lives inside a
      fixed-size StackPanel so it never overflows the ContentDialog
      chrome. Stage 1 shows the discovery list; Stage 2 swaps the
      content for a small PIN-entry panel.
    -->

    <Grid Width="260" RowSpacing="10" Padding="0,2,0,2">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="2">
            <FontIcon Glyph="&#xE7F4;"
                      FontFamily="Segoe MDL2 Assets"
                      FontSize="22"
                      Foreground="{ThemeResource DialogSubtle}" />
            <TextBlock x:Name="HeaderText"
                       Text="Apple TV Remote"
                       HorizontalAlignment="Center"
                       FontSize="13" FontWeight="SemiBold"
                       Foreground="{ThemeResource DialogText}" />
            <TextBlock x:Name="SubText"
                       Text="Looking for Apple TVs…"
                       HorizontalAlignment="Center"
                       FontSize="11" Opacity="0.7"
                       Foreground="{ThemeResource DialogText}"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
        </StackPanel>

        <!-- Stage 1: scrolling device list (fixed height so it never grows) -->
        <Grid Grid.Row="1" x:Name="ListPanel">
            <Border CornerRadius="6"
                    Background="{ThemeResource DialogPanel}"
                    Padding="2"
                    Height="160">
                <ScrollViewer VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="2">
                        <TextBlock x:Name="EmptyHint"
                                   Text="No Apple TVs found yet — make sure the TV is awake."
                                   Visibility="Visible"
                                   FontSize="11"
                                   Padding="8,12"
                                   TextWrapping="Wrap"
                                   Opacity="0.7"
                                   Foreground="{ThemeResource DialogText}" />
                        <ListView x:Name="DeviceList"
                                  Visibility="Collapsed"
                                  SelectionMode="Single"
                                  SelectionChanged="OnDeviceSelected">
                            <ListView.ItemTemplate>
                                <DataTemplate>
                                    <Grid Padding="4,4" ColumnSpacing="6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon Grid.Column="0"
                                                  Glyph="&#xE7F4;"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="14" />
                                        <StackPanel Grid.Column="1" Spacing="0">
                                            <TextBlock Text="{Binding Name}"
                                                       FontSize="12" FontWeight="SemiBold"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding Address}"
                                                       FontSize="10" Opacity="0.6"
                                                       MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                        <FontIcon Grid.Column="2"
                                                  Glyph="&#xE76C;"
                                                  FontFamily="Segoe MDL2 Assets"
                                                  FontSize="10"
                                                  Opacity="0.5" />
                                    </Grid>
                                </DataTemplate>
                            </ListView.ItemTemplate>
                        </ListView>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- Stage 2: PIN entry -->
        <StackPanel Grid.Row="1" x:Name="PinPanel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    Spacing="10">
            <TextBlock x:Name="PinPrompt"
                       FontSize="11"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="{ThemeResource DialogText}" />
            <TextBox x:Name="PinBox"
                     FontSize="20"
                     FontWeight="SemiBold"
                     FontFamily="Consolas"
                     Width="120"
                     MaxLength="4"
                     TextAlignment="Center"
                     PlaceholderText="1234"
                     InputScope="Number" />
            <TextBlock x:Name="PinError"
                       Foreground="#CC4040"
                       Visibility="Collapsed"
                       FontSize="11"
                       MaxWidth="220"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <ProgressBar x:Name="PairProgress"
                         Width="200"
                         Height="3"
                         IsIndeterminate="True"
                         Visibility="Collapsed" />
        </StackPanel>
    </Grid>
</ContentDialog>
