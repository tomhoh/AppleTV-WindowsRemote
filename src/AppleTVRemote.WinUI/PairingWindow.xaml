<?xml version="1.0" encoding="utf-8"?>
<winuiex:WindowEx
    x:Class="AppleTVRemote.WinUI.PairingWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winuiex="using:WinUIEx"
    Title="Pair Apple TV"
    Width="380" Height="460"
    IsMinimizable="False"
    IsMaximizable="False"
    IsResizable="False">

    <!--
      Standalone pairing window (was previously a ContentDialog inside
      the tiny remote popup — content overflowed). Same two-stage
      layout (device list → PIN entry) but with full window real estate.
    -->

    <winuiex:WindowEx.SystemBackdrop>
        <MicaBackdrop Kind="Base" />
    </winuiex:WindowEx.SystemBackdrop>

    <Grid Padding="20" RowSpacing="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"    />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" HorizontalAlignment="Center" Spacing="4">
            <FontIcon Glyph="&#xE7F4;"
                      FontFamily="Segoe MDL2 Assets"
                      FontSize="28"
                      Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            <TextBlock x:Name="HeaderText"
                       Text="Pair Apple TV"
                       HorizontalAlignment="Center"
                       FontSize="16" FontWeight="SemiBold"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBlock x:Name="SubText"
                       Text="Looking for Apple TVs on your network…"
                       HorizontalAlignment="Center"
                       FontSize="12" Opacity="0.8"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                       TextWrapping="Wrap"
                       TextAlignment="Center" />
        </StackPanel>

        <!-- Stage 1: device list -->
        <Border Grid.Row="1"
                x:Name="ListPanel"
                CornerRadius="8"
                Background="{ThemeResource ControlFillColorDefaultBrush}"
                BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                BorderThickness="1"
                Padding="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <TextBlock x:Name="EmptyHint"
                               Visibility="Visible"
                               Padding="12,16"
                               FontSize="12"
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               Opacity="0.7"
                               Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                               Text="No Apple TVs found yet — make sure the TV is awake and on the same network." />
                    <ListView x:Name="DeviceList"
                              Visibility="Collapsed"
                              SelectionMode="Single"
                              SelectionChanged="OnDeviceSelected">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid Padding="6,4" ColumnSpacing="10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <FontIcon Grid.Column="0"
                                              Glyph="&#xE7F4;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="16" />
                                    <StackPanel Grid.Column="1" Spacing="1">
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="13" FontWeight="SemiBold"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Subtitle}"
                                                   FontSize="11" Opacity="0.6"
                                                   MaxLines="1" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <FontIcon Grid.Column="2"
                                              Glyph="&#xE76C;"
                                              FontFamily="Segoe MDL2 Assets"
                                              FontSize="11"
                                              Opacity="0.5" />
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Stage 2: PIN entry -->
        <StackPanel Grid.Row="1"
                    x:Name="PinPanel"
                    Visibility="Collapsed"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Spacing="12">
            <TextBlock x:Name="PinPrompt"
                       FontSize="12"
                       TextAlignment="Center"
                       TextWrapping="Wrap"
                       MaxWidth="260"
                       Foreground="{ThemeResource TextFillColorPrimaryBrush}" />
            <TextBox x:Name="PinBox"
                     FontSize="24"
                     FontWeight="SemiBold"
                     FontFamily="Consolas"
                     Width="140"
                     MaxLength="4"
                     TextAlignment="Center"
                     PlaceholderText="1234"
                     InputScope="Number" />
            <TextBlock x:Name="PinError"
                       Foreground="#E04040"
                       Visibility="Collapsed"
                       FontSize="12"
                       MaxWidth="280"
                       TextAlignment="Center"
                       TextWrapping="Wrap" />
            <ProgressBar x:Name="PairProgress"
                         Width="240"
                         Height="3"
                         IsIndeterminate="True"
                         Visibility="Collapsed" />
            <ScrollViewer x:Name="PairLogScroll"
                          Visibility="Collapsed"
                          Width="320" Height="100"
                          VerticalScrollBarVisibility="Auto">
                <TextBlock x:Name="PairLog"
                           FontFamily="Consolas" FontSize="10"
                           TextWrapping="NoWrap" />
            </ScrollViewer>
        </StackPanel>

        <!-- Footer -->
        <Grid Grid.Row="2" ColumnSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="6" HorizontalAlignment="Left">
                <Button x:Name="RescanBtn"
                        Content="Rescan"
                        Click="OnRescanClicked"
                        Padding="14,4" />
                <Button x:Name="ByIpBtn"
                        Content="Enter IP…"
                        Click="OnEnterIpClicked"
                        Padding="14,4" />
            </StackPanel>
            <Button Grid.Column="1"
                    x:Name="BackBtn"
                    Content="Back"
                    Click="OnBackClicked"
                    Visibility="Collapsed"
                    Padding="14,4" />
            <Button Grid.Column="2"
                    x:Name="CancelBtn"
                    Content="Cancel"
                    Click="OnCancelClicked"
                    Padding="14,4" />
            <Button Grid.Column="2"
                    x:Name="PairBtn"
                    Content="Pair"
                    Click="OnPairClicked"
                    Style="{ThemeResource AccentButtonStyle}"
                    IsEnabled="False"
                    Visibility="Collapsed"
                    Padding="16,4" />
        </Grid>
    </Grid>
</winuiex:WindowEx>
