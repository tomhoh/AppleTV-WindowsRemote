<?xml version="1.0" encoding="utf-8"?>
<winuiex:WindowEx
    x:Class="AppleTVRemote.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winuiex="using:WinUIEx"
    Title="Apple TV Remote"
    Width="200" Height="380"
    IsMinimizable="False"
    IsMaximizable="False"
    IsResizable="False">

    <!--
      Brushes live in App.xaml ThemeDictionaries and bind here via
      {ThemeResource ...} — WinUI's native theme-resolution mechanism.
      MainWindow.ApplyTheme() flips Root.RequestedTheme between Light
      and Dark, which causes every ThemeResource consumer to re-resolve
      automatically without us walking the visual tree.
    -->

    <winuiex:WindowEx.SystemBackdrop>
        <MicaBackdrop Kind="BaseAlt" />
    </winuiex:WindowEx.SystemBackdrop>

    <Grid x:Name="Root">
        <Grid.Resources>
            <Style x:Key="PillButton" TargetType="Button">
                <Setter Property="Foreground"  Value="{ThemeResource ButtonGlyph}" />
                <Setter Property="Background"  Value="{ThemeResource ButtonMaterial}" />
                <Setter Property="BorderBrush" Value="{ThemeResource ButtonStroke}" />
                <Setter Property="BorderThickness" Value="0.5" />
                <Setter Property="CornerRadius"    Value="22" />
                <Setter Property="Width"  Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment"   Value="Center" />
            </Style>

            <Style x:Key="CircleButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
                <Setter Property="Width"  Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="FontSize" Value="10" />
            </Style>
        </Grid.Resources>

        <!-- Top-left: close X -->
        <Button x:Name="CloseBtn"
                Style="{StaticResource CircleButton}"
                Content="&#xE8BB;"
                FontFamily="Segoe MDL2 Assets"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="12,10,0,0"
                ToolTipService.ToolTip="Close"
                Click="OnCloseClicked" />

        <!-- Top-right: power -->
        <Button x:Name="PowerBtn"
                Style="{StaticResource CircleButton}"
                Content="&#xE7E8;"
                FontFamily="Segoe MDL2 Assets"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,10,12,0"
                ToolTipService.ToolTip="Wake"
                Click="OnPowerClicked" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    Margin="0,10,0,0"
                    Spacing="6">
            <ComboBox x:Name="DeviceCombo"
                      Width="100"
                      Visibility="Collapsed" />
            <Button x:Name="OpenPairBtn"
                    Style="{StaticResource CircleButton}"
                    Content="&#xE710;"
                    FontFamily="Segoe MDL2 Assets"
                    ToolTipService.ToolTip="Pair a new Apple TV"
                    Click="OnOpenPairClicked" />
        </StackPanel>

        <StackPanel Margin="0,42,0,0" HorizontalAlignment="Center" Spacing="12">

            <Grid x:Name="Clickpad"
                  Width="130" Height="130"
                  Margin="0,8,0,4"
                  Background="Transparent"
                  PointerPressed="OnClickpadPointerPressed"
                  PointerMoved="OnClickpadPointerMoved"
                  PointerReleased="OnClickpadPointerReleased"
                  PointerExited="OnClickpadPointerExited">

                <Ellipse Fill="{ThemeResource ClickpadRing}"
                         Stroke="{ThemeResource ButtonStroke}"
                         StrokeThickness="0.5" />

                <Path x:Name="HoverQuadrant"
                      Fill="{ThemeResource ClickpadHover}"
                      IsHitTestVisible="False"
                      Visibility="Collapsed" />

                <Path x:Name="QuadrantHighlight"
                      Fill="{ThemeResource ClickpadPressed}"
                      IsHitTestVisible="False"
                      Visibility="Collapsed" />

                <Ellipse x:Name="SelectDisc"
                         Width="72" Height="72"
                         Fill="{ThemeResource SelectFill}"
                         Stroke="{ThemeResource ButtonStroke}"
                         StrokeThickness="0.5"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="SelectScale" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>

            <Grid Margin="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource PillButton}"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE76B;"
                        Tag="Menu"  Click="OnHidClicked" />
                <Button Grid.Column="1" Style="{StaticResource PillButton}"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE7F4;"
                        Tag="Home"  Click="OnHidClicked" />
                <Button Grid.Column="2" Style="{StaticResource PillButton}"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE720;"
                        Tag="Siri"  Click="OnHidClicked" />
            </Grid>

            <Grid Margin="8,0,8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource PillButton}"
                        FontFamily="Segoe MDL2 Assets" Content="&#xF5B0;"
                        Tag="PlayPause"
                        HorizontalAlignment="Left"
                        Click="OnHidClicked" />

                <Border Grid.Column="1"
                        x:Name="VolumeRocker"
                        Width="44" Height="92"
                        HorizontalAlignment="Right"
                        CornerRadius="22"
                        Background="{ThemeResource ButtonMaterial}"
                        BorderBrush="{ThemeResource ButtonStroke}"
                        BorderThickness="0.5"
                        PointerPressed="OnVolumePointerPressed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="1" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="11"
                                   Foreground="{ThemeResource ButtonGlyph}"
                                   Text="&#xE995;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                        <Rectangle Grid.Row="1" Fill="{ThemeResource ButtonStroke}" />
                        <TextBlock Grid.Row="2"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="11"
                                   Foreground="{ThemeResource ButtonGlyph}"
                                   Text="&#xE993;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
    </Grid>
</winuiex:WindowEx>
