<?xml version="1.0" encoding="utf-8"?>
<winuiex:WindowEx
    x:Class="AppleTVRemote.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winuiex="using:WinUIEx"
    Title="Apple TV Remote"
    Width="320" Height="480"
    IsMinimizable="False"
    IsMaximizable="False">

    <Grid Padding="12" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />     <!-- header -->
            <RowDefinition Height="*"    />     <!-- d-pad  -->
            <RowDefinition Height="Auto" />     <!-- bottom row -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Device:" VerticalAlignment="Center" />
            <ComboBox  x:Name="DeviceCombo" Width="200" />
            <Button    Content="Pair…" Click="OnPairClicked" />
        </StackPanel>

        <!-- 3x3 D-pad -->
        <Grid Grid.Row="1" RowSpacing="6" ColumnSpacing="6"
              HorizontalAlignment="Center" VerticalAlignment="Center">
            <Grid.RowDefinitions>
                <RowDefinition Height="64" />
                <RowDefinition Height="64" />
                <RowDefinition Height="64" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="64" />
                <ColumnDefinition Width="64" />
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="1" Content="&#x25B2;" Tag="Up"     Click="OnHidClicked" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <Button Grid.Row="1" Grid.Column="0" Content="&#x25C0;" Tag="Left"   Click="OnHidClicked" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <Button Grid.Row="1" Grid.Column="1" Content="&#x25CF;" Tag="Select" Click="OnHidClicked" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <Button Grid.Row="1" Grid.Column="2" Content="&#x25B6;" Tag="Right"  Click="OnHidClicked" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
            <Button Grid.Row="2" Grid.Column="1" Content="&#x25BC;" Tag="Down"   Click="OnHidClicked" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" />
        </Grid>

        <!-- Bottom row -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
            <Button Content="Menu"   Tag="Menu"       Click="OnHidClicked" />
            <Button Content="Home"   Tag="Home"       Click="OnHidClicked" />
            <Button Content="&#x23EF;" Tag="PlayPause" Click="OnHidClicked" />
            <Button Content="Vol&#x2212;" Tag="VolumeDown" Click="OnHidClicked" />
            <Button Content="Vol+"  Tag="VolumeUp"   Click="OnHidClicked" />
        </StackPanel>
    </Grid>
</winuiex:WindowEx>
