<?xml version="1.0" encoding="utf-8"?>
<winuiex:WindowEx
    x:Class="AppleTVRemote.WinUI.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winuiex="using:WinUIEx"
    Title="Apple TV Remote"
    Width="168" Height="372"
    IsMinimizable="False"
    IsMaximizable="False"
    IsResizable="False"
    IsAlwaysOnTop="True"
    IsShownInSwitchers="False">

    <!--
      Title bar / chrome is removed in code-behind via an OverlappedPresenter
      configured borderless. The custom "close X" button in the top-left of
      the remote replaces the standard window-control buttons.

      All theme-sensitive brushes live in the Grid.Resources below and get
      re-seeded by MainWindow.ApplyTheme() when ActualThemeChanged fires
      (which the framework raises when the system theme flips).
    -->

    <!-- No SystemBackdrop: Mica had a blue-tinted look that didn't match the
         desktop mode. The Grid's Background is set from code in ApplyTheme()
         to the neutral system window background (near-black in dark mode,
         near-white in light) so the popup blends with the desktop. -->
    <Grid x:Name="Root" RequestedTheme="Default">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />   <!-- Now-Playing banner (collapsed unless metadata) -->
            <RowDefinition Height="*"    />   <!-- launcher + remote columns -->
        </Grid.RowDefinitions>
        <Grid.Resources>
            <SolidColorBrush x:Key="ButtonMaterial"   Color="#33FFFFFF" />
            <SolidColorBrush x:Key="ButtonMaterialHv" Color="#55FFFFFF" />
            <SolidColorBrush x:Key="ButtonMaterialDn" Color="#80FFFFFF" />
            <SolidColorBrush x:Key="ButtonGlyph"      Color="#E6FFFFFF" />
            <SolidColorBrush x:Key="ButtonStroke"     Color="#33FFFFFF" />
            <SolidColorBrush x:Key="ClickpadRing"     Color="#33FFFFFF" />
            <SolidColorBrush x:Key="ClickpadHover"    Color="#1AFFFFFF" />
            <SolidColorBrush x:Key="ClickpadPressed"  Color="#33FFFFFF" />
            <SolidColorBrush x:Key="SelectFill"       Color="#80FFFFFF" />
            <SolidColorBrush x:Key="SelectHoverFill"  Color="#A6FFFFFF" />

            <Style x:Key="PillButton" TargetType="Button">
                <Setter Property="Foreground" Value="{StaticResource ButtonGlyph}" />
                <Setter Property="Background" Value="{StaticResource ButtonMaterial}" />
                <Setter Property="BorderBrush" Value="{StaticResource ButtonStroke}" />
                <Setter Property="BorderThickness" Value="0.5" />
                <Setter Property="CornerRadius"    Value="22" />
                <Setter Property="Width"  Value="44" />
                <Setter Property="Height" Value="44" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="HorizontalContentAlignment" Value="Center" />
                <Setter Property="VerticalContentAlignment"   Value="Center" />
            </Style>

            <Style x:Key="CircleButton" TargetType="Button" BasedOn="{StaticResource PillButton}">
                <Setter Property="Width"  Value="22" />
                <Setter Property="Height" Value="22" />
                <Setter Property="CornerRadius" Value="11" />
                <Setter Property="FontSize" Value="10" />
            </Style>
        </Grid.Resources>

        <!-- ── Row 0: Now-Playing banner ── -->
        <Border x:Name="NowPlayingBanner"
                Grid.Row="0"
                Margin="12,8,12,2"
                Padding="10,6"
                CornerRadius="10"
                Background="{StaticResource ButtonMaterial}"
                BorderBrush="{StaticResource ButtonStroke}"
                BorderThickness="0.5"
                Visibility="Collapsed">
            <StackPanel Orientation="Vertical">
                <TextBlock x:Name="NowPlayingTitle"
                           FontSize="12" FontWeight="SemiBold"
                           Foreground="{StaticResource ButtonGlyph}"
                           TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="NowPlayingArtist"
                           FontSize="10"
                           Foreground="{StaticResource ButtonGlyph}"
                           Opacity="0.7"
                           TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </Border>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LauncherCol" Width="0" />
            <!-- `*` (not fixed 168) so the column fills whatever the
                 client area actually is — with hasBorder:true the OS
                 frame consumes some of the outer 168pt window width,
                 and a hardcoded 168 overflows to the right. -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ── Column 0: app launcher (slides out left) ──
             No RenderTransform: the slide-in/out is driven by a
             Composition animation on the visual's `Translation`
             property (see AnimateSlide in code-behind), which runs on
             the compositor thread. A DoubleAnimation on a
             TranslateTransform.X had to be a dependent animation and
             was UI-thread-bound, which is what made the slide jerky. -->
        <Grid x:Name="LauncherPanel"
              Grid.Column="0"
              Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Header: "Apps" + refresh + close-chevron -->
            <Grid Grid.Row="0" Margin="10,12,10,4">
                <TextBlock Text="Apps"
                           FontSize="14"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource ButtonGlyph}"
                           VerticalAlignment="Center" />
                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Spacing="6">
                    <Button x:Name="LauncherRefreshBtn"
                            Style="{StaticResource CircleButton}"
                            FontFamily="Segoe MDL2 Assets"
                            Content="&#xE72C;"
                            ToolTipService.ToolTip="Refresh app list"
                            Click="OnLauncherRefreshClicked" />
                    <Button x:Name="LauncherCloseBtn"
                            Style="{StaticResource CircleButton}"
                            FontFamily="Segoe MDL2 Assets"
                            Content="&#xE76C;"
                            ToolTipService.ToolTip="Close app launcher"
                            Click="OnLauncherCloseClicked" />
                </StackPanel>
            </Grid>

            <!-- Search box -->
            <Border Grid.Row="1"
                    Margin="10,2,10,6"
                    CornerRadius="8"
                    Background="{StaticResource ButtonMaterial}"
                    BorderBrush="{StaticResource ButtonStroke}"
                    BorderThickness="0.5">
                <TextBox x:Name="LauncherSearch"
                         Margin="4"
                         FontSize="12"
                         BorderThickness="0"
                         Background="Transparent"
                         Foreground="{StaticResource ButtonGlyph}"
                         TextChanged="OnLauncherSearchChanged" />
            </Border>

            <!-- App grid -->
            <ScrollViewer Grid.Row="2"
                          Margin="6,0,6,10"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled">
                <Grid>
                    <TextBlock x:Name="LauncherStatus"
                               Text="Loading apps…"
                               FontSize="11"
                               Foreground="{StaticResource ButtonGlyph}"
                               Opacity="0.7"
                               HorizontalAlignment="Center"
                               Margin="0,24,0,0"
                               Visibility="Visible" />
                    <ItemsControl x:Name="LauncherList"
                                  Visibility="Collapsed">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <VariableSizedWrapGrid Orientation="Horizontal"
                                                       ItemWidth="68"
                                                       ItemHeight="82" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </ScrollViewer>
        </Grid>

        <!-- ── Column 1: remote ── -->
        <!-- x:Name'd + opaque Background so the launcher sliding in
             from behind (with translation X=+panelWidth) is fully
             obscured by this column while it's under the remote.
             Without an opaque background the launcher shows through
             the remote as it slides. Painted by PaintBrushConsumers
             so it tracks the popup Root.Background on theme changes. -->
        <Grid x:Name="RemoteColumn" Grid.Column="1">

        <!-- Full-width device dropdown at the top of the popup, with
             10pt gutter on each side. The old close-X + pair-button
             UI moved off the popup — dismissal is click-outside and
             pairing lives in the tray context menu. -->
        <!-- Pill-shaped device picker. Button + MenuFlyout replaces
             ComboBox so there's no built-in DropDown chevron and no
             DropDownOverlay column stealing space on the right — the
             whole 26pt pill is available for the device name. Clicking
             the button opens a MenuFlyout with one item per paired
             device; RefreshDevices() populates it. -->
        <Button x:Name="DeviceButton"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Top"
                Margin="8,16,8,0"
                Height="26"
                MinHeight="26"
                FontSize="12"
                CornerRadius="13"
                Padding="10,0,10,0"
                HorizontalContentAlignment="Center"
                VerticalContentAlignment="Center"
                Background="Transparent"
                BorderBrush="Transparent"
                UseSystemFocusVisuals="False"
                Content="Select Apple TV…"
                Visibility="Collapsed">
            <!-- ThemeDictionaries + ButtonBackground* overrides didn't
                 reliably reach the default WinUI 3 Button template on
                 Windows in v0.4.2 — the button still had chrome at
                 rest. Definitive fix: full ControlTemplate override
                 with VisualStateManager setters. Default (Normal
                 state) is Background="Transparent" from the Button
                 element; PointerOver/Pressed swap the Grid's Background
                 to theme-aware brushes defined in the local
                 ThemeDictionaries below. -->
            <Button.Resources>
                <ResourceDictionary>
                    <ResourceDictionary.ThemeDictionaries>
                        <ResourceDictionary x:Key="Dark">
                            <SolidColorBrush x:Key="DeviceButtonHoverFill"   Color="#08FFFFFF"/>
                            <SolidColorBrush x:Key="DeviceButtonPressedFill" Color="#14FFFFFF"/>
                        </ResourceDictionary>
                        <ResourceDictionary x:Key="Light">
                            <SolidColorBrush x:Key="DeviceButtonHoverFill"   Color="#08000000"/>
                            <SolidColorBrush x:Key="DeviceButtonPressedFill" Color="#14000000"/>
                        </ResourceDictionary>
                    </ResourceDictionary.ThemeDictionaries>
                </ResourceDictionary>
            </Button.Resources>
            <Button.Template>
                <ControlTemplate TargetType="Button">
                    <!-- Background hardcoded Transparent (not
                         TemplateBinding) so Normal state is DEFINITELY
                         transparent regardless of what the default
                         Button Style's Background setter resolves to.
                         VisualStates for PointerOver / Pressed swap
                         it. Normal explicitly re-sets Transparent so
                         VSM reliably reverts after a hover exit on
                         every WinUI build. -->
                    <Grid x:Name="ButtonSurface"
                          Background="Transparent"
                          BorderBrush="Transparent"
                          BorderThickness="0"
                          CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal">
                                    <VisualState.Setters>
                                        <Setter Target="ButtonSurface.Background"
                                                Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="ButtonSurface.Background"
                                                Value="{ThemeResource DeviceButtonHoverFill}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="ButtonSurface.Background"
                                                Value="{ThemeResource DeviceButtonPressedFill}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <VisualState.Setters>
                                        <Setter Target="ButtonSurface.Background"
                                                Value="Transparent" />
                                    </VisualState.Setters>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <ContentPresenter
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            Padding="{TemplateBinding Padding}"
                            FontSize="{TemplateBinding FontSize}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Button.Template>
            <Button.Flyout>
                <MenuFlyout x:Name="DeviceFlyout" Placement="Bottom" />
            </Button.Flyout>
        </Button>

        <!-- Row under the dropdown: apps toggle on the left, power
             on the right. Power moved from the header row per user
             feedback ("below the selection dropdown on the right"). -->
        <!-- Apps/Power row Y offset: 46 → 54 to preserve the 12pt
             gap under the DeviceButton after it moved down 8pt too. -->
        <Grid Margin="8,54,8,0" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0"
                    x:Name="AppsBtn"
                    Style="{StaticResource CircleButton}"
                    Content="&#xE71D;"
                    FontFamily="Segoe MDL2 Assets"
                    ToolTipService.ToolTip="Apps"
                    Click="OnAppsClicked" />
            <Button Grid.Column="2"
                    x:Name="PowerBtn"
                    Style="{StaticResource CircleButton}"
                    Content="&#xE7E8;"
                    FontFamily="Segoe MDL2 Assets"
                    ToolTipService.ToolTip="Wake"
                    Click="OnPowerClicked" />
        </Grid>

        <StackPanel Margin="0,78,0,0" HorizontalAlignment="Center" Spacing="8">

            <Grid x:Name="Clickpad"
                  Width="130" Height="130"
                  Margin="0,0,0,0"
                  Background="Transparent"
                  PointerPressed="OnClickpadPointerPressed"
                  PointerMoved="OnClickpadPointerMoved"
                  PointerReleased="OnClickpadPointerReleased"
                  PointerExited="OnClickpadPointerExited">

                <Ellipse Fill="{StaticResource ClickpadRing}"
                         Stroke="{StaticResource ButtonStroke}"
                         StrokeThickness="0.5" />

                <Path x:Name="HoverQuadrant"
                      Fill="{StaticResource ClickpadHover}"
                      IsHitTestVisible="False"
                      Visibility="Collapsed" />

                <Path x:Name="QuadrantHighlight"
                      Fill="{StaticResource ClickpadPressed}"
                      IsHitTestVisible="False"
                      Visibility="Collapsed" />

                <Ellipse x:Name="SelectDisc"
                         Width="72" Height="72"
                         Fill="{StaticResource SelectFill}"
                         Stroke="{StaticResource ButtonStroke}"
                         StrokeThickness="0.5"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         RenderTransformOrigin="0.5,0.5">
                    <Ellipse.RenderTransform>
                        <ScaleTransform x:Name="SelectScale" />
                    </Ellipse.RenderTransform>
                </Ellipse>
            </Grid>

            <Grid Margin="6,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <!-- Margin="4,0" on each pill gives ~8pt of visible
                     gap between adjacent buttons — user reported they
                     were touching horizontally with the previous
                     column-stretched layout. -->
                <Button Grid.Column="0" Style="{StaticResource PillButton}"
                        Margin="4,0"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE76B;"
                        Tag="Menu"  Click="OnHidClicked" />
                <!-- Home: tap → home screen, hold → tvOS app-switcher. A
                     DispatcherQueueTimer started on press distinguishes them. -->
                <Button Grid.Column="1" Style="{StaticResource PillButton}"
                        Margin="4,0"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE7F4;"
                        Tag="Home"
                        ToolTipService.ToolTip="Home (hold for app switcher)"
                        PointerPressed="OnHomeDown"
                        PointerReleased="OnHomeUp"
                        PointerExited="OnHomeLeave"
                        PointerCanceled="OnHomeLeave" />
                <Button Grid.Column="2" Style="{StaticResource PillButton}"
                        Margin="4,0"
                        FontFamily="Segoe MDL2 Assets" Content="&#xE720;"
                        Tag="Siri"  Click="OnHidClicked" />
            </Grid>

            <Grid Margin="6,0,6,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Style="{StaticResource PillButton}"
                        Margin="4,0"
                        FontFamily="Segoe MDL2 Assets" Content="&#xF5B0;"
                        Tag="PlayPause"
                        HorizontalAlignment="Left"
                        Click="OnHidClicked" />

                <Border Grid.Column="1"
                        x:Name="VolumeRocker"
                        Width="44" Height="92"
                        Margin="4,0"
                        HorizontalAlignment="Right"
                        CornerRadius="22"
                        Background="{StaticResource ButtonMaterial}"
                        BorderBrush="{StaticResource ButtonStroke}"
                        BorderThickness="0.5"
                        PointerPressed="OnVolumePointerPressed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition />
                            <RowDefinition Height="1" />
                            <RowDefinition />
                        </Grid.RowDefinitions>
                        <TextBlock Grid.Row="0"
                                   x:Name="VolUpGlyph"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="11"
                                   Foreground="{StaticResource ButtonGlyph}"
                                   Text="&#xE995;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                        <Rectangle Grid.Row="1" Fill="{StaticResource ButtonStroke}" />
                        <TextBlock Grid.Row="2"
                                   x:Name="VolDownGlyph"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="11"
                                   Foreground="{StaticResource ButtonGlyph}"
                                   Text="&#xE993;"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Grid>
        </StackPanel>
        </Grid>  <!-- Column 1 wrapper -->
        </Grid>  <!-- Row 1 inner grid (launcher + remote columns) -->
    </Grid>
</winuiex:WindowEx>
