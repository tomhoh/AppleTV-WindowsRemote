<winuiex:WindowEx
    x:Class="AppleTVRemote.WinUI.TextInputWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:winuiex="using:WinUIEx">
    <!-- Screen-centered pill. CornerRadius=44 == Height/2 == a true
         capsule. LayerFillColorDefaultBrush is theme-aware so the
         pill shifts with system light/dark; a thin subtle outline
         gives it the macOS-ish depth. -->
    <Grid Background="{ThemeResource LayerFillColorDefaultBrush}"
          BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
          BorderThickness="1"
          CornerRadius="44">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <FontIcon Grid.Column="0"
                  Glyph="&#xE721;"
                  FontFamily="Segoe Fluent Icons"
                  FontSize="22"
                  Margin="28,0,8,0"
                  VerticalAlignment="Center"
                  Foreground="{ThemeResource TextFillColorSecondaryBrush}"/>
        <TextBox x:Name="InputBox"
                 Grid.Column="1"
                 PlaceholderText="Search"
                 FontSize="28"
                 BorderThickness="0"
                 Background="Transparent"
                 Padding="8,0,28,0"
                 VerticalAlignment="Stretch"
                 VerticalContentAlignment="Center"
                 TextChanged="OnTextChanged"
                 KeyDown="OnKeyDown"/>
    </Grid>
</winuiex:WindowEx>
