<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="AppleTVRemote.WinUI.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AppleTVRemote.WinUI">

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
              All theme-sensitive brushes live in ThemeDictionaries so
              {ThemeResource ...} consumers re-resolve automatically when
              the active theme flips. This is the framework-standard
              WinUI pattern — way more reliable than manually swapping
              brush instances in Grid.Resources.
            -->
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="ButtonMaterial"   Color="#33000000" />
                    <SolidColorBrush x:Key="ButtonMaterialHv" Color="#52000000" />
                    <SolidColorBrush x:Key="ButtonMaterialDn" Color="#72000000" />
                    <SolidColorBrush x:Key="ButtonGlyph"      Color="#E6000000" />
                    <SolidColorBrush x:Key="ButtonStroke"     Color="#40000000" />
                    <SolidColorBrush x:Key="ClickpadRing"     Color="#26000000" />
                    <SolidColorBrush x:Key="ClickpadHover"    Color="#1E000000" />
                    <SolidColorBrush x:Key="ClickpadPressed"  Color="#40000000" />
                    <SolidColorBrush x:Key="SelectFill"       Color="#99FFFFFF" />
                    <SolidColorBrush x:Key="SelectHoverFill"  Color="#BFFFFFFF" />
                    <SolidColorBrush x:Key="DialogText"       Color="#E6000000" />
                    <SolidColorBrush x:Key="DialogSubtle"     Color="#99000000" />
                    <SolidColorBrush x:Key="DialogPanel"      Color="#11000000" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="ButtonMaterial"   Color="#33FFFFFF" />
                    <SolidColorBrush x:Key="ButtonMaterialHv" Color="#52FFFFFF" />
                    <SolidColorBrush x:Key="ButtonMaterialDn" Color="#72FFFFFF" />
                    <SolidColorBrush x:Key="ButtonGlyph"      Color="#E6FFFFFF" />
                    <SolidColorBrush x:Key="ButtonStroke"     Color="#40FFFFFF" />
                    <SolidColorBrush x:Key="ClickpadRing"     Color="#26FFFFFF" />
                    <SolidColorBrush x:Key="ClickpadHover"    Color="#1EFFFFFF" />
                    <SolidColorBrush x:Key="ClickpadPressed"  Color="#40FFFFFF" />
                    <SolidColorBrush x:Key="SelectFill"       Color="#66FFFFFF" />
                    <SolidColorBrush x:Key="SelectHoverFill"  Color="#80FFFFFF" />
                    <SolidColorBrush x:Key="DialogText"       Color="#E6FFFFFF" />
                    <SolidColorBrush x:Key="DialogSubtle"     Color="#99FFFFFF" />
                    <SolidColorBrush x:Key="DialogPanel"      Color="#15FFFFFF" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
