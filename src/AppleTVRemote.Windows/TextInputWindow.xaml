<Window x:Class="AppleTVRemote.Windows.TextInputWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ResizeMode="NoResize"
        Width="720"
        Height="88"
        SizeToContent="Manual">
    <!-- Screen-centered pill holding a search glyph + big "Search"
         TextBox. CornerRadius=44 == Height/2 == true capsule.
         Translucent frosted-ish background + subtle outline gives
         the macOS style depth. No title bar / close button. -->
    <Border CornerRadius="44"
            Background="#E6F6F6F6"
            BorderBrush="#1A000000"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24"
                              ShadowDepth="4"
                              Direction="270"
                              Color="#000000"
                              Opacity="0.18"/>
        </Border.Effect>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Search glyph. Segoe Fluent Icons ships with Win11; on
                 older Windows the font falls back to the system
                 default and the glyph still renders as the matching
                 code point in Segoe MDL2 Assets. -->
            <TextBlock Grid.Column="0"
                       Text="&#xE721;"
                       FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                       FontSize="22"
                       Foreground="#80000000"
                       Margin="32,0,8,0"
                       VerticalAlignment="Center"/>

            <!-- Placeholder text sits behind the TextBox. WPF has no
                 first-class placeholder; TextChanged collapses it when
                 the box has any content. -->
            <Grid Grid.Column="1">
                <TextBlock x:Name="PlaceholderText"
                           Text="Search"
                           Foreground="#66000000"
                           FontSize="28"
                           Margin="12,0,32,0"
                           VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
                <TextBox x:Name="InputBox"
                         Background="Transparent"
                         BorderThickness="0"
                         FontSize="28"
                         Padding="10,0,32,0"
                         VerticalContentAlignment="Center"
                         Foreground="#F0000000"
                         CaretBrush="#B0000000"
                         AcceptsReturn="False"
                         TextChanged="OnTextChanged"
                         KeyDown="OnKeyDown"/>
            </Grid>

            <!-- Empties the field on the TV as well as this box. Typing
                 asserts the whole box, so without a way to empty it there is
                 no way to drop a term the TV is still holding. Styled flat so
                 it reads as part of the pill rather than a button on top of
                 it. -->
            <Button x:Name="ClearButton"
                    Grid.Column="2"
                    Click="OnClearClick"
                    Margin="0,0,24,0"
                    Padding="10,6"
                    BorderThickness="0"
                    Background="Transparent"
                    Cursor="Hand"
                    ToolTip="Clear the text on the Apple TV"
                    VerticalAlignment="Center">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                CornerRadius="22"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Button.Template>
                <TextBlock Text="&#xE894;"
                           FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets"
                           FontSize="18"
                           Foreground="#80000000"/>
            </Button>
        </Grid>
    </Border>
</Window>
