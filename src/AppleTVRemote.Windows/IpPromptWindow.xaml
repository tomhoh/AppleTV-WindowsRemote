<Window x:Class="AppleTVRemote.Windows.IpPromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apple TV IP address"
        Width="340" Height="170"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <StackPanel Margin="16" VerticalAlignment="Center">
        <TextBlock FontSize="12" Opacity="0.8" TextWrapping="Wrap">
            Find it on your Apple TV under
            Settings → Network → Wi-Fi/Ethernet → IP address.
        </TextBlock>
        <TextBox x:Name="IpBox"
                 FontSize="16"
                 Margin="0,12,0,0"
                 Padding="6"
                 KeyDown="OnKeyDown" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="Cancel" Padding="14,4" Margin="0,0,6,0" Click="OnCancel" />
            <Button Content="Probe"  Padding="14,4" IsDefault="True" Click="OnOk" />
        </StackPanel>
    </StackPanel>
</Window>
