<Window x:Class="AppleTVRemote.Windows.PairingWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pair Apple TV"
        Width="380" Height="440"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*"    />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header / status text -->
        <StackPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock x:Name="HeaderText"
                       Text="Discovering Apple TVs on your network…"
                       FontSize="14" FontWeight="SemiBold" />
            <TextBlock x:Name="SubText"
                       Text="Make sure your TV is awake and on the same network."
                       Margin="0,4,0,0"
                       FontSize="11" Opacity="0.7" TextWrapping="Wrap" />
        </StackPanel>

        <!-- Stage 1: discovered-device list -->
        <ListBox x:Name="DeviceList"
                 Grid.Row="1"
                 SelectionChanged="OnDeviceSelected"
                 BorderThickness="1"
                 BorderBrush="#33000000">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Margin="8,6">
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                        <TextBlock FontSize="10" Opacity="0.6">
                            <Run Text="{Binding Address}" />
                            <Run Text=":" />
                            <Run Text="{Binding Port}" />
                        </TextBlock>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- Stage 2: PIN entry — hidden until a device is selected -->
        <StackPanel x:Name="PinPanel"
                    Grid.Row="1"
                    Visibility="Collapsed"
                    VerticalAlignment="Center">
            <TextBlock x:Name="PinPrompt"
                       Text="Enter the 4-digit PIN shown on your Apple TV:"
                       FontSize="13" />
            <PasswordBox x:Name="PinBox"
                         Margin="0,12,0,0"
                         FontSize="22"
                         Padding="8"
                         MaxLength="6"
                         HorizontalContentAlignment="Center" />
            <TextBlock x:Name="PinError"
                       Margin="0,8,0,0"
                       Foreground="#CC0000"
                       Visibility="Collapsed"
                       FontSize="11" TextWrapping="Wrap" />
            <ProgressBar x:Name="PairProgress"
                         Margin="0,12,0,0"
                         Height="4"
                         IsIndeterminate="True"
                         Visibility="Collapsed" />
        </StackPanel>

        <!-- Footer buttons -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"    />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="RescanBtn"
                    Content="Rescan"
                    Click="OnRescanClicked"
                    HorizontalAlignment="Left"
                    Padding="12,4" />
            <Button Grid.Column="1" x:Name="BackBtn"
                    Content="Back"
                    Click="OnBackClicked"
                    Visibility="Collapsed"
                    Margin="0,0,8,0"
                    Padding="12,4" />
            <Button Grid.Column="2" x:Name="PairBtn"
                    Content="Pair"
                    Click="OnPairClicked"
                    Visibility="Collapsed"
                    IsDefault="True"
                    Padding="16,4" />
        </Grid>
    </Grid>
</Window>
