<Application x:Class="AppleTVRemote.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AppleTVRemote.Windows"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!--
          The tray icon lives in App.xaml so it survives popup window
          show/hide cycles (and so we don't accidentally pin the
          MainWindow as the app's lifetime root).
        -->
        <tb:TaskbarIcon x:Key="TrayIcon"
                        ToolTipText="Apple TV Remote"
                        Visibility="Visible"
                        TrayLeftMouseUp="OnTrayLeftClicked">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Open"  Click="OnOpenClicked" />
                    <Separator />
                    <MenuItem Header="Exit"  Click="OnExitClicked" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
