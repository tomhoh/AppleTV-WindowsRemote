<Application x:Class="AppleTVRemote.Windows.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AppleTVRemote.Windows"
             xmlns:tb="http://www.hardcodet.net/taskbar"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!--
          The tray icon lives in App.xaml so it survives popup window
          show/hide cycles (and so we don't accidentally pin the
          MainWindow as the app's lifetime root).
        -->
        <tb:TaskbarIcon x:Key="TrayIcon"
                        ToolTipText="Apple TV Remote"
                        Visibility="Visible"
                        TrayLeftMouseUp="OnTrayLeftClicked">
            <!-- ContextMenu is rebuilt on demand in code-behind so it can
                 reflect the current paired-device list + "Open at login"
                 state. The empty stub here exists so Hardcodet attaches
                 the context-menu handler at all. -->
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Opened="OnTrayMenuOpening" />
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Application.Resources>
</Application>
