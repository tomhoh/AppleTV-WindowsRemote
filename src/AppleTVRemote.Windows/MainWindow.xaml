<Window x:Class="AppleTVRemote.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:AppleTVRemote.Windows"
        mc:Ignorable="d"
        Title="Apple TV Remote"
        Width="320" Height="480"
        ResizeMode="NoResize"
        WindowStyle="ToolWindow"
        ShowInTaskbar="False"
        Topmost="True">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />     <!-- header / device picker -->
            <RowDefinition Height="*"    />     <!-- d-pad area              -->
            <RowDefinition Height="Auto" />     <!-- bottom action row       -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal">
            <TextBlock Text="Device:" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox  x:Name="DeviceCombo" Width="220" />
            <Button    x:Name="PairButton" Content="Pair…" Margin="8,0,0,0" Click="OnPairClicked" />
        </StackPanel>

        <!-- 3x3 D-pad. Center column has the rocker; bottom-center is Select. -->
        <Grid Grid.Row="1" Margin="0,16,0,0">
            <Grid.RowDefinitions>
                <RowDefinition />
                <RowDefinition />
                <RowDefinition />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition />
                <ColumnDefinition />
            </Grid.ColumnDefinitions>

            <Button Grid.Row="0" Grid.Column="1" Content="▲" Tag="Up"     Click="OnHidClicked" />
            <Button Grid.Row="1" Grid.Column="0" Content="◀" Tag="Left"   Click="OnHidClicked" />
            <Button Grid.Row="1" Grid.Column="1" Content="●" Tag="Select" Click="OnHidClicked" />
            <Button Grid.Row="1" Grid.Column="2" Content="▶" Tag="Right"  Click="OnHidClicked" />
            <Button Grid.Row="2" Grid.Column="1" Content="▼" Tag="Down"   Click="OnHidClicked" />
        </Grid>

        <!-- Bottom row: menu / home / playpause / vol± -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center">
            <Button Content="Menu"   Tag="Menu"       Click="OnHidClicked" Margin="2" />
            <Button Content="Home"   Tag="Home"       Click="OnHidClicked" Margin="2" />
            <Button Content="⏯"     Tag="PlayPause"  Click="OnHidClicked" Margin="2" />
            <Button Content="Vol−"   Tag="VolumeDown" Click="OnHidClicked" Margin="2" />
            <Button Content="Vol+"   Tag="VolumeUp"   Click="OnHidClicked" Margin="2" />
        </StackPanel>
    </Grid>
</Window>
