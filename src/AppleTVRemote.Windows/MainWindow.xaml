<Window x:Class="AppleTVRemote.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apple TV Remote"
        Width="200" Height="380"
        SizeToContent="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Deactivated="OnDeactivated">
    <!--
      Look mirrors the macOS MenuBarRemote popover:
        - 165pt body, aluminum vertical gradient + soft top highlight
        - Rounded outer corners (the popover IS the remote)
        - 130pt round clickpad with a 72pt center select disc
        - Compact button row: Menu / Home / mic
        - Bottom row: PlayPause + tall volume pill
      Light/dark variants of the body gradient are picked at runtime by
      reading the system theme (see MainWindow.xaml.cs).
    -->

    <Window.Resources>
        <!-- Body gradient (light default; overridden in code-behind for dark). -->
        <LinearGradientBrush x:Key="BodyGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#D6D6D6" />
            <GradientStop Offset="1" Color="#A8A8A8" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BodyHighlight" StartPoint="0,0" EndPoint="0,0.5">
            <GradientStop Offset="0" Color="#59FFFFFF" />
            <GradientStop Offset="1" Color="#00FFFFFF" />
        </LinearGradientBrush>

        <!-- Glassy "material" backing for the round buttons + select disc. -->
        <SolidColorBrush x:Key="ButtonMaterial" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="ButtonGlyph"    Color="#C7000000" />
        <SolidColorBrush x:Key="ButtonStroke"   Color="#26000000" />
        <SolidColorBrush x:Key="ClickpadRing"   Color="#3FFFFFFF" />

        <!-- Pill button (Menu / Home / mic / PlayPause).
             Press-feedback is colour-driven; we skip the SwiftUI-style
             scale animation because nested transform targets in WPF
             template triggers are awkward to reach by name. -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource ButtonGlyph}" />
            <Setter Property="FontSize"   Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Width"      Value="44" />
            <Setter Property="Height"     Value="44" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="22"
                                Background="{StaticResource ButtonMaterial}"
                                BorderBrush="{StaticResource ButtonStroke}"
                                BorderThickness="0.5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="#80FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Power button — tiny circle in the top-right corner. -->
        <Style x:Key="PowerButton" TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource ButtonGlyph}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Width"  Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bg"
                                     Fill="{StaticResource ButtonMaterial}"
                                     Stroke="{StaticResource ButtonStroke}"
                                     StrokeThickness="0.5" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="#55FFFFFF" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="#80FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- Outer drop shadow + rounded body. -->
    <Border CornerRadius="22"
            Background="{DynamicResource BodyGradient}"
            BorderBrush="#33000000"
            BorderThickness="0.5">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="22" ShadowDepth="3" />
        </Border.Effect>

        <Grid>
            <!-- Top body highlight (light reflection) -->
            <Rectangle Fill="{DynamicResource BodyHighlight}" RadiusX="22" RadiusY="22" />

            <!-- Power button: top-right corner of the body -->
            <Button x:Name="PowerBtn"
                    Style="{StaticResource PowerButton}"
                    Content="&#xE7E8;"
                    FontFamily="Segoe MDL2 Assets"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,10,12,0"
                    Click="OnPowerClicked" />

            <!-- Device picker (hidden by default; toggled by Cmd/Right-click area later). -->
            <ComboBox x:Name="DeviceCombo"
                      Visibility="Collapsed"
                      Width="140" HorizontalAlignment="Left"
                      VerticalAlignment="Top" Margin="12,10,0,0" />

            <!-- Remote body: clickpad on top, then button rows -->
            <StackPanel Margin="0,32,0,0" HorizontalAlignment="Center">

                <!-- Clickpad: round outer ring + 5 invisible click regions + center disc -->
                <Grid x:Name="Clickpad"
                      Width="130" Height="130"
                      Margin="0,8,0,16"
                      MouseLeftButtonDown="OnClickpadDown"
                      MouseMove="OnClickpadMove"
                      MouseLeftButtonUp="OnClickpadUp"
                      Background="Transparent"
                      ClipToBounds="True">

                    <!-- Outer ring -->
                    <Ellipse Fill="{StaticResource ClickpadRing}"
                             Stroke="#26000000"
                             StrokeThickness="0.5" />

                    <!-- Pressed-quadrant overlay (driven from code-behind) -->
                    <Path x:Name="QuadrantHighlight"
                          Fill="#38FFFFFF"
                          IsHitTestVisible="False"
                          Visibility="Collapsed" />

                    <!-- Center select disc -->
                    <Ellipse x:Name="SelectDisc"
                             Width="72" Height="72"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Fill="#A6FFFFFF"
                             Stroke="#26000000"
                             StrokeThickness="0.5"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="SelectScale" ScaleX="1" ScaleY="1" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>

                <!-- Row 1: Menu / Home / Mic (Siri) -->
                <Grid Margin="8,0,8,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource PillButton}"
                            FontFamily="Segoe MDL2 Assets"
                            Content="&#xE76B;"
                            Tag="Menu"
                            ToolTip="Menu"
                            Click="OnHidClicked" />

                    <Button Grid.Column="1"
                            Style="{StaticResource PillButton}"
                            FontFamily="Segoe MDL2 Assets"
                            Content="&#xE7F4;"
                            Tag="Home"
                            ToolTip="Home"
                            Click="OnHidClicked" />

                    <Button Grid.Column="2"
                            Style="{StaticResource PillButton}"
                            FontFamily="Segoe MDL2 Assets"
                            Content="&#xE720;"
                            Tag="Siri"
                            ToolTip="Siri"
                            Click="OnHidClicked" />
                </Grid>

                <!-- Row 2: PlayPause (left) + Volume rocker (right) -->
                <Grid Margin="8,0,8,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0"
                            Style="{StaticResource PillButton}"
                            FontFamily="Segoe MDL2 Assets"
                            Content="&#xF5B0;"
                            Tag="PlayPause"
                            ToolTip="Play / Pause"
                            HorizontalAlignment="Left"
                            Click="OnHidClicked" />

                    <!-- Volume rocker: single 44x92 pill, top half = +, bottom = − -->
                    <Border Grid.Column="1"
                            Width="44" Height="92"
                            HorizontalAlignment="Right"
                            CornerRadius="22"
                            Background="{StaticResource ButtonMaterial}"
                            BorderBrush="{StaticResource ButtonStroke}"
                            BorderThickness="0.5"
                            MouseLeftButtonDown="OnVolumeClicked"
                            Cursor="Hand">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="1" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource ButtonGlyph}"
                                       FontSize="11"
                                       Text="&#xE995;"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <Rectangle Grid.Row="1" Fill="#1A000000" />
                            <TextBlock Grid.Row="2"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{StaticResource ButtonGlyph}"
                                       FontSize="11"
                                       Text="&#xE993;"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
