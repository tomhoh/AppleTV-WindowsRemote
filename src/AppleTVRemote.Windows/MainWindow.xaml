<Window x:Class="AppleTVRemote.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Apple TV Remote"
        Width="200" Height="380"
        SizeToContent="Manual"
        ResizeMode="NoResize"
        WindowStyle="None"
        AllowsTransparency="True"
        ShowInTaskbar="False"
        Topmost="True"
        Background="Transparent"
        Deactivated="OnDeactivated">
    <!--
      All theme-sensitive brushes are seeded as light-mode defaults here
      and re-applied at runtime by MainWindow.ApplyTheme(). They use
      DynamicResource bindings so the swap is live (system theme change
      via SystemEvents.UserPreferenceChanged triggers a re-apply).
    -->

    <Window.Resources>
        <!-- BODY (changes with theme) -->
        <LinearGradientBrush x:Key="BodyGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Offset="0" Color="#D6D6D6" />
            <GradientStop Offset="1" Color="#A8A8A8" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="BodyHighlight" StartPoint="0,0" EndPoint="0,0.5">
            <GradientStop Offset="0" Color="#59FFFFFF" />
            <GradientStop Offset="1" Color="#00FFFFFF" />
        </LinearGradientBrush>

        <!-- BUTTONS (changes with theme — light mode uses darker glass for contrast) -->
        <SolidColorBrush x:Key="ButtonMaterial"   Color="#33000000" />
        <SolidColorBrush x:Key="ButtonMaterialHv" Color="#52000000" />
        <SolidColorBrush x:Key="ButtonMaterialDn" Color="#72000000" />
        <SolidColorBrush x:Key="ButtonGlyph"      Color="#E6000000" />
        <SolidColorBrush x:Key="ButtonStroke"     Color="#33000000" />

        <!-- CLICKPAD (changes with theme) -->
        <SolidColorBrush x:Key="ClickpadRing"     Color="#33000000" />
        <SolidColorBrush x:Key="ClickpadHover"    Color="#1E000000" />
        <SolidColorBrush x:Key="ClickpadPressed"  Color="#33000000" />
        <SolidColorBrush x:Key="SelectFill"       Color="#80FFFFFF" />
        <SolidColorBrush x:Key="SelectHoverFill"  Color="#A6FFFFFF" />

        <!-- Pill button. Press feedback is colour-driven; hover gets a
             slightly lighter glass to give the mouse-over signal. -->
        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ButtonGlyph}" />
            <Setter Property="FontSize"   Value="16" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Width"      Value="44" />
            <Setter Property="Height"     Value="44" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bg"
                                CornerRadius="22"
                                Background="{DynamicResource ButtonMaterial}"
                                BorderBrush="{DynamicResource ButtonStroke}"
                                BorderThickness="0.5">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}"
                                              TextBlock.FontWeight="{TemplateBinding FontWeight}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ButtonMaterialHv}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource ButtonMaterialDn}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Small circular icon button — used for Close and Power. -->
        <Style x:Key="CircleButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource ButtonGlyph}" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Width"  Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Grid>
                            <Ellipse x:Name="Bg"
                                     Fill="{DynamicResource ButtonMaterial}"
                                     Stroke="{DynamicResource ButtonStroke}"
                                     StrokeThickness="0.5" />
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              TextBlock.Foreground="{TemplateBinding Foreground}"
                                              TextBlock.FontSize="{TemplateBinding FontSize}" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="{DynamicResource ButtonMaterialHv}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bg" Property="Fill" Value="{DynamicResource ButtonMaterialDn}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border CornerRadius="22"
            Background="{DynamicResource BodyGradient}"
            BorderBrush="#33000000"
            BorderThickness="0.5">
        <Border.Effect>
            <DropShadowEffect Color="Black" Opacity="0.35" BlurRadius="22" ShadowDepth="3" />
        </Border.Effect>

        <Grid>
            <Rectangle Fill="{DynamicResource BodyHighlight}" RadiusX="22" RadiusY="22" />

            <!-- Top-left: close X -->
            <Button x:Name="CloseBtn"
                    Style="{StaticResource CircleButton}"
                    Content="&#xE8BB;"
                    FontFamily="Segoe MDL2 Assets"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="12,10,0,0"
                    ToolTip="Close"
                    Click="OnCloseClicked" />

            <!-- Top-right: power -->
            <Button x:Name="PowerBtn"
                    Style="{StaticResource CircleButton}"
                    Content="&#xE7E8;"
                    FontFamily="Segoe MDL2 Assets"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Margin="0,10,12,0"
                    ToolTip="Wake"
                    Click="OnPowerClicked" />

            <!-- Device picker (hidden until paired devices exist). -->
            <ComboBox x:Name="DeviceCombo"
                      Visibility="Collapsed"
                      Width="120" HorizontalAlignment="Center"
                      VerticalAlignment="Top" Margin="0,10,0,0" />

            <StackPanel Margin="0,42,0,0" HorizontalAlignment="Center">

                <Grid x:Name="Clickpad"
                      Width="130" Height="130"
                      Margin="0,8,0,16"
                      MouseLeftButtonDown="OnClickpadDown"
                      MouseMove="OnClickpadMove"
                      MouseLeftButtonUp="OnClickpadUp"
                      MouseLeave="OnClickpadLeave"
                      Background="Transparent"
                      ClipToBounds="True">

                    <!-- Outer ring + thin inset stroke -->
                    <Ellipse Fill="{DynamicResource ClickpadRing}"
                             Stroke="{DynamicResource ButtonStroke}"
                             StrokeThickness="0.5" />

                    <!-- Hover quadrant overlay (subtle) -->
                    <Path x:Name="HoverQuadrant"
                          Fill="{DynamicResource ClickpadHover}"
                          IsHitTestVisible="False"
                          Visibility="Collapsed" />

                    <!-- Pressed quadrant flash (animates out) -->
                    <Path x:Name="QuadrantHighlight"
                          Fill="{DynamicResource ClickpadPressed}"
                          IsHitTestVisible="False"
                          Visibility="Collapsed" />

                    <!-- Center select disc; fill flips on hover -->
                    <Ellipse x:Name="SelectDisc"
                             Width="72" Height="72"
                             HorizontalAlignment="Center"
                             VerticalAlignment="Center"
                             Fill="{DynamicResource SelectFill}"
                             Stroke="{DynamicResource ButtonStroke}"
                             StrokeThickness="0.5"
                             RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                            <ScaleTransform x:Name="SelectScale" ScaleX="1" ScaleY="1" />
                        </Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>

                <!-- Row 1: Menu / Home / Siri -->
                <Grid Margin="8,0,8,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource PillButton}"
                            FontFamily="Segoe MDL2 Assets" Content="&#xE76B;"
                            Tag="Menu"  ToolTip="Menu"      Click="OnHidClicked" />
                    <Button Grid.Column="1" Style="{StaticResource PillButton}"
                            FontFamily="Segoe MDL2 Assets" Content="&#xE7F4;"
                            Tag="Home"  ToolTip="Home"      Click="OnHidClicked" />
                    <Button Grid.Column="2" Style="{StaticResource PillButton}"
                            FontFamily="Segoe MDL2 Assets" Content="&#xE720;"
                            Tag="Siri"  ToolTip="Siri"      Click="OnHidClicked" />
                </Grid>

                <!-- Row 2: PlayPause + Volume rocker -->
                <Grid Margin="8,0,8,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition />
                        <ColumnDefinition />
                    </Grid.ColumnDefinitions>
                    <Button Grid.Column="0" Style="{StaticResource PillButton}"
                            FontFamily="Segoe MDL2 Assets" Content="&#xF5B0;"
                            Tag="PlayPause" ToolTip="Play / Pause"
                            HorizontalAlignment="Left"
                            Click="OnHidClicked" />

                    <Border Grid.Column="1"
                            x:Name="VolumeRocker"
                            Width="44" Height="92"
                            HorizontalAlignment="Right"
                            CornerRadius="22"
                            Background="{DynamicResource ButtonMaterial}"
                            BorderBrush="{DynamicResource ButtonStroke}"
                            BorderThickness="0.5"
                            MouseLeftButtonDown="OnVolumeClicked"
                            Cursor="Hand">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition />
                                <RowDefinition Height="1" />
                                <RowDefinition />
                            </Grid.RowDefinitions>
                            <TextBlock Grid.Row="0"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{DynamicResource ButtonGlyph}"
                                       FontSize="11"
                                       Text="&#xE995;"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                            <Rectangle Grid.Row="1" Fill="{DynamicResource ButtonStroke}" />
                            <TextBlock Grid.Row="2"
                                       FontFamily="Segoe MDL2 Assets"
                                       Foreground="{DynamicResource ButtonGlyph}"
                                       FontSize="11"
                                       Text="&#xE993;"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Border>
                </Grid>
            </StackPanel>
        </Grid>
    </Border>
</Window>
